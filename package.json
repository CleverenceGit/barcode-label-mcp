{
  "name": "@cleverence/barcode-label-mcp",
  "version": "1.8.2",
  "mcpName": "com.cleverence/barcode-label",
  "description": "MCP server for Cleverence Label — author, validate, render and embed barcode label designs",
  "license": "MIT",
  "homepage": "https://cleverence.com/label",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CleverenceGit/barcode-label-mcp.git"
  },
  "type": "module",
  "bin": {
    "barcode-label-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.0.0",
    "minimist": "^1.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "barcode",
    "label",
    "printing",
    "cleverence"
  ]
}
